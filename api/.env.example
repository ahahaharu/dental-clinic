# Скопируйте в api/.env: cp api/.env.example api/.env
# Значения ниже совпадают с docker-compose.yml

# MySQL
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=root
DB_NAME=dental_clinic
DB_PORT=3306

# Порт API (5000 на macOS занят AirPlay Receiver)
PORT=5001

# Секрет для подписи JWT — любая длинная случайная строка
JWT_SECRET=change_me_to_a_long_random_string

# MongoDB (логи) и Redis (сессии, кэш)
MONGO_URI=mongodb://127.0.0.1:27017/dental_logs
REDIS_URI=redis://127.0.0.1:6379
